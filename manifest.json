{
   "manifest_version": 3,
   "name": "Auto Twitch Drops Pro",
   "version": "1.5.0",
   "description": "Automatically claim Twitch drops, channel points, and monitor drop campaigns in the background.",
   "action": {
      "default_popup": "index.html"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "permissions": [
      "alarms",
      "storage",
      "tabs",
      "cookies",
      "contentSettings",
      "notifications"
   ],
   "host_permissions": [
      "*://*.twitch.tv/*",
      "https://gql.twitch.tv/*"
   ],
   "icons": {
      "16": "assets/img/atd-16.png",
      "32": "assets/img/atd-32.png",
      "48": "assets/img/atd-48.png",
      "128": "assets/img/atd-128.png"
   },
   "content_scripts": [
      {
         "js": [ "inject.js" ],
         "matches": [ "https://*.twitch.tv/*" ],
         "run_at": "document_start"
      }
   ],
   "web_accessible_resources": [
      {
         "matches": [ "https://*.twitch.tv/*" ],
         "resources": [ "assets/img/*.png", "onPage.js" ]
      }
   ]
}
